# Frontend build-time public configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Browser requests must target the same-origin Next.js BFF, never FastAPI directly.
# NEXT_PUBLIC_API_BASE_URL is intentionally not used.

# Server-only Next.js BFF configuration (set independently for web and admin apps).
APP_PUBLIC_URL=http://localhost:3000
GRAPHYTION_API_URL=http://localhost:8000/api/v1
GRAPHYTION_BFF_SHARED_SECRET=replace_with_a_long_random_shared_secret

# FastAPI runtime
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
# Production must contain explicit HTTPS origins for trusted browser frontends.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SUPABASE_URL=https://xtjwmezfzexvupbfsdqt.supabase.co
SUPABASE_JWT_ISSUER=https://xtjwmezfzexvupbfsdqt.supabase.co/auth/v1
SUPABASE_ANON_KEY=replace_with_supabase_publishable_or_anon_key
SUPABASE_JWKS_URL=https://xtjwmezfzexvupbfsdqt.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
BFF_SHARED_SECRET=replace_with_the_same_random_shared_secret_as_GRAPHYTION_BFF_SHARED_SECRET

# API runtime uses this dedicated least-privilege login first.
# Keep the administrative/migration DATABASE_URL unchanged if your deployment uses it.
# Configure the password out-of-band; never commit credentials.
GRAPHYTION_RUNTIME_DATABASE_URL=postgresql+asyncpg://graphytion_api:SET_VIA_SECRET_MANAGER@db.xtjwmezfzexvupbfsdqt.supabase.co:5432/postgres?ssl=require
# Optional migration-owner/admin connection; API runtime will only use this as a
# backward-compatible fallback when GRAPHYTION_RUNTIME_DATABASE_URL is absent.
DATABASE_URL=

LOG_LEVEL=INFO
GRAPHYTION_API_BASE_URL=http://api:8000/api/v1
INTERNAL_WORKER_TOKEN=replace_with_a_long_random_internal_worker_token
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_DEFAULT_PROVIDER=openai
LLM_MODEL_KEY=gpt-4.1-mini
GEMINI_MODEL_KEY=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=60
OPENAI_TTS_MODEL=tts-1

# Real invitation email provider configuration. Resend sender domain must be verified.
INVITATION_EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
INVITATION_FROM_EMAIL=Graphytion <invite@example.com>

# Private Redis queue wake-up channel; PostgreSQL remains the durable job store.
REDIS_URL=
